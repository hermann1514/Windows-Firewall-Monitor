<Application x:Class="FirewallMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FirewallMonitor.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StringEqualsConverter x:Key="Eq" />
            <conv:StringEqualsVisibilityConverter x:Key="EqVis" />
            <BooleanToVisibilityConverter x:Key="BoolVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
