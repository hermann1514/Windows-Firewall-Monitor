<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral zinc palette. Color is reserved for meaning (blocked/allowed, focus). -->
    <SolidColorBrush x:Key="WindowBg" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBg" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlBg" Color="#F1F1F3" />
    <SolidColorBrush x:Key="ControlHover" Color="#E8E8EB" />
    <SolidColorBrush x:Key="ControlPressed" Color="#D9D9DE" />
    <SolidColorBrush x:Key="Line" Color="#ECECEF" />
    <SolidColorBrush x:Key="LineStrong" Color="#DCDCE0" />
    <SolidColorBrush x:Key="TextPrimary" Color="#18181B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B6B74" />
    <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Accent" Color="#2F6FEB" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#22915A" />
    <SolidColorBrush x:Key="Danger" Color="#D93B40" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDF0F0" />
    <SolidColorBrush x:Key="Warning" Color="#B7791F" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FDF6E7" />
    <SolidColorBrush x:Key="RowHover" Color="#F7F7F8" />
    <SolidColorBrush x:Key="RowSelected" Color="#EAF0FD" />
    <SolidColorBrush x:Key="Bar" Color="#C9C9D0" />
    <SolidColorBrush x:Key="SegmentOn" Color="#FFFFFF" />
</ResourceDictionary>
