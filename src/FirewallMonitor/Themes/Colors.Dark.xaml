<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral graphite palette. Color is reserved for meaning (blocked/allowed, focus). -->
    <SolidColorBrush x:Key="WindowBg" Color="#141416" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#18181B" />
    <SolidColorBrush x:Key="PanelBg" Color="#18181B" />
    <SolidColorBrush x:Key="ControlBg" Color="#222226" />
    <SolidColorBrush x:Key="ControlHover" Color="#2A2A2F" />
    <SolidColorBrush x:Key="ControlPressed" Color="#3A3A41" />
    <SolidColorBrush x:Key="Line" Color="#26262B" />
    <SolidColorBrush x:Key="LineStrong" Color="#34343B" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E4E4E7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8B8B93" />
    <SolidColorBrush x:Key="TextMuted" Color="#5F5F68" />
    <SolidColorBrush x:Key="Accent" Color="#5B8DEF" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#3DB17A" />
    <SolidColorBrush x:Key="Danger" Color="#EF5B5F" />
    <SolidColorBrush x:Key="DangerSoft" Color="#2A1A1C" />
    <SolidColorBrush x:Key="Warning" Color="#E5A33B" />
    <SolidColorBrush x:Key="WarningSoft" Color="#2A2216" />
    <SolidColorBrush x:Key="RowHover" Color="#1E1E22" />
    <SolidColorBrush x:Key="RowSelected" Color="#232A38" />
    <SolidColorBrush x:Key="Bar" Color="#4A4A53" />
    <SolidColorBrush x:Key="SegmentOn" Color="#36363D" />
</ResourceDictionary>
