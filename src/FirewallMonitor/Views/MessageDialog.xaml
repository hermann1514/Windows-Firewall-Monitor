<Window x:Class="FirewallMonitor.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Background="{DynamicResource SurfaceBg}"
        Icon="/Assets/app.ico" Title="Firewall Monitor" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="22,20,22,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" Style="{StaticResource Glyph}" FontSize="20" VerticalAlignment="Top"
                       Margin="0,1,14,0" Foreground="{DynamicResource Accent}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Abbrechen" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
