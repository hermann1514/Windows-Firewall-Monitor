<Window x:Class="FirewallMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FirewallMonitor.Converters"
        xmlns:vm="clr-namespace:FirewallMonitor.ViewModels"
        Title="Firewall Monitor" Height="780" Width="1280" MinHeight="500" MinWidth="900">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="StatusBrush" TrueBrush="#2E9E4F" FalseBrush="#D13438" />
        <Style x:Key="Toolbar" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>

        <!-- Profile status bar -->
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding IsEnabled, Converter={StaticResource StatusBrush}}"
                                CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" />
                                </StackPanel>
                                <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                        VerticalAlignment="Center" Padding="8,2" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource Toolbar}" />
                <Button Content="Logging aktivieren" Command="{Binding EnableLoggingCommand}" Style="{StaticResource Toolbar}" />
            </StackPanel>
        </Grid>

        <TabControl Margin="8,0,8,8">
            <!-- ===================== Live ===================== -->
            <TabItem Header="Live-Verbindungen">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="140" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}"
                                Style="{StaticResource Toolbar}" MinWidth="100" />
                        <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="DarkOrange" />
                        <CheckBox Content="Auto-Scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.FilterColumns}" SelectedItem="{Binding FilterColumn}"
                                  Width="90" Margin="0,0,4,0" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.ActionFilters}" SelectedItem="{Binding ActionFilter}"
                                  Width="100" Margin="0,0,8,0" />
                        <Button Content="CSV-Export" Command="{Binding ExportCommand}" Style="{StaticResource Toolbar}" />
                        <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Top-10 counters -->
                    <Grid Grid.Row="1" Margin="0,0,0,6" Height="215">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Top 10 blockierte Prozesse" Margin="0,0,4,0">
                            <ItemsControl ItemsSource="{Binding TopBlockedProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                         Height="10" Foreground="#D13438" Margin="4,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Top 10 Remote-IPs" Margin="4,0,0,0">
                            <ItemsControl ItemsSource="{Binding TopRemoteIps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                         Height="10" Foreground="#0078D4" Margin="4,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </Grid>

                    <DataGrid x:Name="LiveGrid" Grid.Row="2"
                              ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                        <Setter Property="Background" Value="#FDE7E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Regel für diesen Prozess erstellen…" Command="{Binding CreateProcessRuleCommand}" />
                                <MenuItem Header="Regel für diese IP erstellen…" Command="{Binding CreateIpRuleCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75" />
                            <DataGridTextColumn Header="Prozess" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="60" />
                            <DataGridTextColumn Header="Richtung" Binding="{Binding DirectionText}" Width="85" />
                            <DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="70" />
                            <DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="*" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*" />
                            <DataGridTextColumn Header="Aktion" Binding="{Binding ActionText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" />
                    <TextBox Grid.Row="4" Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <!-- ===================== Regeln ===================== -->
            <TabItem Header="Firewall-Regeln">
                <DockPanel Margin="6" DataContext="{Binding Rules}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0" />
                        <Button Content="Neue Regel…" Command="{Binding NewCommand}" Style="{StaticResource Toolbar}" />
                        <Button Content="Aktivieren" Command="{Binding EnableCommand}" Style="{StaticResource Toolbar}" />
                        <Button Content="Deaktivieren" Command="{Binding DisableCommand}" Style="{StaticResource Toolbar}" />
                        <Button Content="Löschen" Command="{Binding DeleteCommand}" Style="{StaticResource Toolbar}" />
                        <Button Content="Neu laden" Command="{Binding RefreshCommand}" Style="{StaticResource Toolbar}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Richtung" Binding="{Binding DirectionText}" Width="85" />
                            <DataGridTextColumn Header="Aktion" Binding="{Binding ActionText}" Width="85" />
                            <DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="75" />
                            <DataGridTextColumn Header="Port" Binding="{Binding Ports}" Width="*" />
                            <DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled, Mode=OneWay}" Width="55" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
