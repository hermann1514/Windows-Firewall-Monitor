<Window x:Class="FirewallMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FirewallMonitor.ViewModels"
        Style="{StaticResource WindowStyle}"
        Icon="/Assets/app.ico"
        Title="Firewall Monitor" Height="840" Width="1360" MinHeight="620" MinWidth="1120">
    <Window.Resources>
        <Style x:Key="LiveRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick" />
        </Style>

        <Style x:Key="RuleRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="-2,0,0,9" />
        </Style>

        <Style x:Key="ValueMono" TargetType="TextBox" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="8,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ===================== Header: navigation + profile status ===================== -->
        <Grid Margin="20,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Verbindungen" Style="{StaticResource TopTab}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Live}" />
                <RadioButton Content="Regeln" Style="{StaticResource TopTab}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Rules}" />
                <RadioButton Content="Einstellungen" Style="{StaticResource TopTab}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Settings}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Firewall" Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" Command="{Binding ToggleCommand}" ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Success}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Setter TargetName="Label" Property="Text" Value="{Binding Name, StringFormat={}{0} aus}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                    Command="{Binding RefreshCommand}" ToolTip="Profilstatus und Regeln neu laden" />
        </Grid>

        <!-- ===================== Pages ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
            <Grid>

                <!-- ============ Connections ============ -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Live}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- toolbar -->
                        <Grid Margin="16,12,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*" MinWidth="180" MaxWidth="380" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource InputShell}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" Margin="10,0,6,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" Tag="Prozess, IP oder Port suchen"
                                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            Width="24" Height="24" Command="{Binding ClearFilterCommand}" ToolTip="Filter zurücksetzen"
                                            Visibility="{Binding IsFiltered, Converter={StaticResource BoolVis}}" />
                                    <Border Grid.Column="3" Width="1" Margin="4,7" Background="{DynamicResource LineStrong}" />
                                    <ComboBox Grid.Column="4" Style="{StaticResource InlineCombo}" Width="96"
                                              ItemsSource="{x:Static vm:MainViewModel.FilterColumns}" SelectedItem="{Binding FilterColumn}"
                                              ToolTip="Suchen in" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Alle" Style="{StaticResource SegmentButton}" GroupName="Action"
                                                 IsChecked="{Binding ActionFilter, Converter={StaticResource Eq}, ConverterParameter=Alle}" />
                                    <RadioButton Content="Zugelassen" Style="{StaticResource SegmentButton}" GroupName="Action"
                                                 IsChecked="{Binding ActionFilter, Converter={StaticResource Eq}, ConverterParameter=Zugelassen}" />
                                    <RadioButton Content="Blockiert" Style="{StaticResource SegmentButton}" GroupName="Action"
                                                 IsChecked="{Binding ActionFilter, Converter={StaticResource Eq}, ConverterParameter=Blockiert}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SegmentHost}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Alle" Style="{StaticResource SegmentButton}" GroupName="Direction"
                                                 ToolTip="Ein- und ausgehende Verbindungen"
                                                 IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Alle}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Direction"
                                                 ToolTip="Nur eingehende Verbindungen"
                                                 IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Ein}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74B;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,0,5,0" />
                                            <TextBlock Text="Ein" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Direction"
                                                 ToolTip="Nur ausgehende Verbindungen"
                                                 IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Aus}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,0,5,0" />
                                            <TextBlock Text="Aus" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Command="{Binding TogglePauseCommand}" MinWidth="100" Margin="0,0,6,0"
                                        ToolTip="Anzeige anhalten. Neue Einträge werden weiter gesammelt.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PauseGlyph}" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding PauseText}" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE718;" IsChecked="{Binding AutoScroll}"
                                              ToolTip="Neue Einträge automatisch oben einblenden (Auto-Scroll)" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE896;" Command="{Binding ExportCommand}"
                                        ToolTip="Aktuelle Ansicht als CSV exportieren" />
                                <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8A0;" IsChecked="{Binding ShowInspector}"
                                              ToolTip="Seitenleiste mit Übersicht und Details ein-/ausblenden" />
                            </StackPanel>
                        </Grid>

                        <!-- pause banner -->
                        <Border Grid.Row="1" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,1,0,0" Padding="16,6,12,6"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE769;" Style="{StaticResource Glyph}" FontSize="11"
                                           Foreground="{DynamicResource Warning}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="Anzeige pausiert" FontWeight="SemiBold" />
                                    <Run Text=" – " Foreground="{DynamicResource TextSecondary}" />
                                    <Run Text="{Binding PendingCount, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{DynamicResource TextSecondary}" />
                                    <Run Text="neue Einträge werden gesammelt und beim Fortsetzen übernommen." Foreground="{DynamicResource TextSecondary}" />
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextPrimary}"
                                        Content="Fortsetzen" Command="{Binding TogglePauseCommand}" MinHeight="26" />
                            </Grid>
                        </Border>

                        <!-- connection table -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                            <Grid>
                                <DataGrid x:Name="LiveGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" SelectionMode="Single"
                                          RowStyle="{StaticResource LiveRow}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Regel für diesen Prozess erstellen…" Command="{Binding CreateProcessRuleCommand}" />
                                            <MenuItem Header="Regel für diese Remote-IP erstellen…" Command="{Binding CreateIpRuleCommand}" />
                                            <Separator />
                                            <MenuItem Header="Rohzeile kopieren" Command="{Binding CopyRawCommand}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"
                                                            ElementStyle="{StaticResource MonoDim}" />
                                        <DataGridTemplateColumn Header="Status" Width="104">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Success}"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="Txt" Text="{Binding ActionText}" Style="{StaticResource Dim}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Richtung" Width="76">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Arrow" Text="&#xE74B;" Style="{StaticResource Glyph}" FontSize="10"
                                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding DirectionShort}" Style="{StaticResource Dim}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                                            <Setter TargetName="Arrow" Property="Text" Value="&#xE74A;" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DirectionKnown}" Value="False">
                                                            <Setter TargetName="Arrow" Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Prozess" Width="*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Cell}" />
                                                        <TextBlock x:Name="Pid" Text="{Binding Pid}" Style="{StaticResource Mono}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Pid}" Value="0">
                                                            <Setter TargetName="Pid" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Remote-Adresse" Binding="{Binding RemoteIp}" Width="1.2*" MinWidth="135"
                                                            ElementStyle="{StaticResource Mono}" />
                                        <DataGridTextColumn Header="Port" Binding="{Binding RemotePortText}" Width="58"
                                                            ElementStyle="{StaticResource Mono}" />
                                        <DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="78"
                                                            ElementStyle="{StaticResource Dim}" />
                                        <DataGridTextColumn Header="Lokaler Port" Binding="{Binding LocalPortText}" Width="92"
                                                            ElementStyle="{StaticResource MonoDim}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- empty state -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=LiveGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                               TextAlignment="Center" Margin="0,4,0,0" MaxWidth="360" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- side panel -->
                    <Border Grid.Column="1" Width="300" Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"
                            Visibility="{Binding ShowInspector, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <!-- overview (no selection) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource InvBoolVis}}">
                                <StackPanel Margin="18,16,14,18">
                                    <TextBlock Text="Übersicht" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Bezogen auf die aktuelle Ansicht" Style="{StaticResource Caption}" Margin="0,2,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Gesamt" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding BlockedCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Danger}" />
                                            <TextBlock Text="Blockiert" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding AllowedCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Zugelassen" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource HLine}" Margin="0,18,0,14" />
                                    <TextBlock Text="MEIST BLOCKIERTE PROZESSE" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                    <ItemsControl x:Name="TopBlockedList" ItemsSource="{Binding TopBlockedProcesses}" Margin="-8,0,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ListButton}" CommandParameter="{Binding Label}"
                                                        Command="{Binding DataContext.FilterProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Liste nach diesem Prozess filtern">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource MonoDim}" Margin="8,0,0,0" />
                                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                                     Foreground="{DynamicResource Danger}" Opacity="0.75" Margin="0,5,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Keine blockierten Verbindungen." Style="{StaticResource EmptyHint}" Margin="0,2,0,0"
                                               Visibility="{Binding HasItems, ElementName=TopBlockedList, Converter={StaticResource InvBoolVis}}" />

                                    <Border Style="{StaticResource HLine}" Margin="0,16,0,14" />
                                    <TextBlock Text="HÄUFIGSTE REMOTE-ADRESSEN" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                    <ItemsControl x:Name="TopRemoteList" ItemsSource="{Binding TopRemoteIps}" Margin="-8,0,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ListButton}" CommandParameter="{Binding Label}"
                                                        Command="{Binding DataContext.FilterIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Liste nach dieser Adresse filtern">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource MonoDim}" Margin="8,0,0,0" />
                                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,5,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Keine Einträge." Style="{StaticResource EmptyHint}" Margin="0,2,0,0"
                                               Visibility="{Binding HasItems, ElementName=TopRemoteList, Converter={StaticResource InvBoolVis}}" />

                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,22,0,0"
                                               Text="Klick auf einen Eintrag filtert die Liste. Eine Verbindung auswählen, um Details zu sehen; Rechtsklick für Regeln." />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- details (selected entry) -->
                            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="18,14,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected.IsBlocked}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Selected.ActionText}" Style="{StaticResource PanelTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Selected.TimestampText}" Style="{StaticResource Caption}" Margin="16,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                            VerticalAlignment="Top" Command="{Binding ClearSelectionCommand}" ToolTip="Details schließen" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="18,16,14,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Prozess" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Column="1" Text="{Binding Selected.ProcessName, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="1" Text="PID" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Selected.PidText, Mode=OneWay}" Style="{StaticResource ValueMono}" />
                                            <TextBlock Grid.Row="2" Text="Programm" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Selected.ProcessPathText, Mode=OneWay}" Style="{StaticResource ValueText}" FontSize="12" />
                                            <TextBlock Grid.Row="3" Text="Richtung" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Selected.DirectionText, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="4" Text="Protokoll" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Selected.Protocol, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="5" Text="Remote" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Selected.Remote, Mode=OneWay}" Style="{StaticResource ValueMono}" />
                                            <TextBlock Grid.Row="6" Text="Lokal" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Selected.Local, Mode=OneWay}" Style="{StaticResource ValueMono}" />
                                            <TextBlock Grid.Row="7" Text="Größe" Style="{StaticResource KeyText}" />
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Selected.SizeText, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                        </Grid>

                                        <Border Style="{StaticResource HLine}" Margin="0,8,0,14" />
                                        <TextBlock Text="REGEL ERSTELLEN" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                        <Button HorizontalContentAlignment="Left" Command="{Binding CreateProcessRuleCommand}"
                                                ToolTip="Öffnet den Regel-Dialog, vorbefüllt mit dem Programmpfad">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE733;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="Für diesen Prozess…" />
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalContentAlignment="Left" Margin="0,6,0,0" Command="{Binding CreateIpRuleCommand}"
                                                ToolTip="Öffnet den Regel-Dialog, vorbefüllt mit der Remote-Adresse">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="Für diese Remote-IP…" />
                                            </StackPanel>
                                        </Button>

                                        <Grid Margin="0,20,0,8">
                                            <TextBlock Text="ROHDATEN" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" MinHeight="24" Padding="6,0"
                                                    Command="{Binding CopyRawCommand}" ToolTip="Logzeile in die Zwischenablage kopieren">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="Kopieren" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Background="{DynamicResource ControlBg}" CornerRadius="5" Padding="10,8">
                                            <TextBox Text="{Binding Selected.RawLine, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Rules ============ -->
                <Grid DataContext="{Binding Rules}"
                      Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=Rules}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="210" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource InputShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="10,0,6,0" />
                                <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" Tag="Name, Programm oder Port suchen"
                                         Margin="0,0,8,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Alle" Style="{StaticResource SegmentButton}" GroupName="Dir"
                                             IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Alle}" />
                                <RadioButton Content="Eingehend" Style="{StaticResource SegmentButton}" GroupName="Dir"
                                             IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Eingehend}" />
                                <RadioButton Content="Ausgehend" Style="{StaticResource SegmentButton}" GroupName="Dir"
                                             IsChecked="{Binding DirectionFilter, Converter={StaticResource Eq}, ConverterParameter=Ausgehend}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Aktivieren" Command="{Binding EnableCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Deaktivieren" Command="{Binding DisableCommand}" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Löschen" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="8,6" Background="{DynamicResource LineStrong}" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="Neue Regel" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowStyle="{StaticResource RuleRow}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Aktivieren" Command="{Binding EnableCommand}" />
                                    <MenuItem Header="Deaktivieren" Command="{Binding DisableCommand}" />
                                    <Separator />
                                    <MenuItem Header="Löschen…" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Success}"
                                                     HorizontalAlignment="Center" ToolTip="{Binding EnabledText}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextMuted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name" Width="2.2*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Richtung" Width="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="10"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding DirectionText}" Style="{StaticResource Dim}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE74B;" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aktion" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Txt" Text="{Binding ActionText}" Style="{StaticResource Dim}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="84" ElementStyle="{StaticResource Dim}" />
                                <DataGridTextColumn Header="Port" Binding="{Binding PortsText}" Width="*" MinWidth="100" ElementStyle="{StaticResource Mono}" />
                                <DataGridTemplateColumn Header="Programm" Width="1.2*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProgramName}" Style="{StaticResource Cell}" ToolTip="{Binding Program}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ============ Settings ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Settings}">
                    <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Darstellung" FontWeight="SemiBold" />
                                <TextBlock Text="„System“ übernimmt die Hell/Dunkel-Einstellung von Windows."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Hell" Style="{StaticResource SegmentButton}" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=Light}" />
                                    <RadioButton Content="Dunkel" Style="{StaticResource SegmentButton}" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=Dark}" />
                                    <RadioButton Content="System" Style="{StaticResource SegmentButton}" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=System}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource HLine}" Margin="0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Protokollierung" FontWeight="SemiBold" />
                                <TextBlock Text="Die Windows Firewall schreibt zugelassene und blockierte Verbindungen in eine Logdatei. Diese Datei wird hier live ausgelesen."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LOGDATEI" Style="{StaticResource Overline}" />
                                <TextBox Text="{Binding LogPath, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="-2,4,0,12" />
                                <Button Content="Protokollierung aktivieren" Command="{Binding EnableLoggingCommand}" HorizontalAlignment="Left" />
                                <TextBlock Text="Schaltet das Logging für alle Profile ein (netsh advfirewall, max. 16 MB)."
                                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource HLine}" Margin="0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Über" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                    <Run Text="Firewall Monitor" />
                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Prozesse werden über offene Sockets (Port → PID) zugeordnet. Bei kurzlebigen oder blockierten Verbindungen ist das nicht immer möglich; sie erscheinen dann ohne Prozessnamen." />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Grid Grid.Row="2" Margin="20,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" ToolTip="{Binding LogPath}">
                <Ellipse Style="{StaticResource LiveDot}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding LiveText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="18,0" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                           Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Live}" />
                <TextBlock Text="{Binding Rules.CountText}" Style="{StaticResource Caption}"
                           Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Rules}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
