<Window x:Class="FirewallMonitor.Views.NewRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FirewallMonitor.ViewModels"
        Style="{StaticResource WindowStyle}" Background="{DynamicResource SurfaceBg}"
        Icon="/Assets/app.ico" Title="Neue Firewall-Regel" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,22">
            <TextBlock Text="Neue Regel" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Regel für die Windows Firewall anlegen. Programm, Port und Remote-Adresse lassen sich kombinieren."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,18" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Margin="0,5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. Block Updater" />

                <TextBlock Grid.Row="1" Text="Richtung" Style="{StaticResource FieldLabel}" />
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Eingehend" Style="{StaticResource SegmentButton}" GroupName="Dir" IsChecked="{Binding IsInbound}" />
                        <RadioButton Content="Ausgehend" Style="{StaticResource SegmentButton}" GroupName="Dir" IsChecked="{Binding IsOutbound}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="Aktion" Style="{StaticResource FieldLabel}" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Zulassen" Style="{StaticResource SegmentButton}" GroupName="Act" IsChecked="{Binding Allow}" />
                        <RadioButton Content="Blockieren" Style="{StaticResource SegmentButton}" GroupName="Act" IsChecked="{Binding Block}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource HLine}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Text="Programm" Style="{StaticResource FieldLabel}" />
                <Grid Grid.Row="4" Grid.Column="1" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" Tag="Alle Programme" />
                    <Button Grid.Column="1" Content="Durchsuchen…" Margin="6,0,0,0" Click="Browse_Click" />
                </Grid>

                <TextBlock Grid.Row="5" Text="Protokoll" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,5" Width="160" HorizontalAlignment="Left"
                          ItemsSource="{x:Static vm:NewRuleViewModel.Protocols}" SelectedItem="{Binding Protocol}" />

                <TextBlock Grid.Row="6" Text="Port" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,5" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Tag="z. B. 443, 80,8080 oder 5000-5010" />

                <TextBlock Grid.Row="7" Text="Remote-Adresse" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,5" Text="{Binding RemoteAddress, UpdateSourceTrigger=PropertyChanged}"
                         Tag="z. B. 203.0.113.7 oder 10.0.0.0/8" />

                <Border Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource HLine}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="9" Text="Profile" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                    <CheckBox Content="Domäne" IsChecked="{Binding Domain}" Margin="0,0,18,0" />
                    <CheckBox Content="Privat" IsChecked="{Binding Private}" Margin="0,0,18,0" />
                    <CheckBox Content="Öffentlich" IsChecked="{Binding Public}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Abbrechen" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="Regel anlegen" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
